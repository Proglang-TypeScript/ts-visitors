{
  "name": "ts-visitor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "typescript": "6.0.3",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "globals": "17.12.0",
    "@eslint/js": "10.0.1"
  },
  "scripts": {
    "start": "node dist/index.js",
    "prebuild": "rm -rf dist",
    "build": "node node_modules/typescript/lib/tsc.js",
    "postinstall": "npm run install:featherweight",
    "build:featherweight": "tsc featherweight-module/featherweight/index.ts",
    "install:featherweight": "mkdir -p node_modules && cp -r featherweight-module/featherweight node_modules",
    "script": "ts-node",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint --max-warnings 0 'src/**/*.ts'",
    "prettier": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "typescript",
    "ast",
    "visitor"
  ],
  "author": "proglang",
  "repository": {
    "url": "git@github.com:proglang/ts-visitors.git"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24 <25"
  }
}
